{
  "manifest_version": 3,
  "name": "CleanRead",
  "version": "1.0.4",
  "description": "Converts web pages, text, and Markdown files into screen-reader-friendly Markdown and downloads raw files (including PDFs, docs, HTML, and binaries).",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CleanRead — Text-to-Markdown & File Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
